# Copy to .env in the repo root. Everything is optional for local use: with no
# DATABASE_URL, the API uses SQLite at backend/afed.db.

# Supabase Postgres connection string (Project settings > Database). Leave empty for SQLite.
DATABASE_URL=

# Only needed for direct Supabase client access. The API does not use these.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required when DATABASE_URL is set and under Docker. At least 32 characters: openssl rand -hex 32
JWT_SECRET=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Narrator: template | hf_api | ollama | local. This seeds the initial setting; afterwards
# the Model settings page is what counts.
QWEN_PROVIDER=template
HF_TOKEN=
QWEN_HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# Defaults to localhost, or to the Docker host under Compose.
# OLLAMA_URL=http://localhost:11434

# Frontend build. Leave empty to use the /api proxy.
VITE_API_URL=
# Set to 1 only for a public demo: shows the viewer demo login on the sign-in page.
VITE_DEMO=
